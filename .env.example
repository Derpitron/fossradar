# GitHub API
GITHUB_REPO_OWNER=wbfoss
GITHUB_REPO_NAME=fossradar

# GitHub Token - ONLY needed for local development
# In GitHub Actions, this is automatically provided as secrets.GITHUB_TOKEN
# Required for: validation, enrichment, auto-verification
# Get token at: https://github.com/settings/tokens (select "public_repo" permission)
GITHUB_TOKEN=

# Clerk Authentication
# Get your keys from: https://dashboard.clerk.com/
# Create a new application and copy the API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
CLERK_SECRET_KEY=YOUR_SECRET_KEY

# Webhooks (optional - for auto-revalidation)
WEBHOOK_SECRET=

# Admin API Key (optional - for manual sitemap ping)
# Used to secure the /api/ping-sitemap endpoint
ADMIN_API_KEY=

# Site URL (for sitemaps)
SITE_URL=https://fossradar.in

# Vercel Blob Storage (automatically configured in Vercel)
# Local development: Get token from Vercel dashboard > Storage > radar-blob-image
# BLOB_READ_WRITE_TOKEN=

# CounterAPI Configuration (for visitor tracking)
# Get your access token from: https://counterapi.com/
COUNTERAPI_COUNTER=
COUNTERAPI_WORKSPACE=fossradar
